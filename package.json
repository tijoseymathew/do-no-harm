{
  "name": "do-no-harm-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "test:browser": "playwright test",
    "dev": "tsx watch server/index.ts",
    "dev:client": "vite --config vite.client.config.ts --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run clean && npm run build:sites",
    "build:local": "npm run clean && npm run build:server && npm run build:client",
    "build:client": "vite build --config vite.client.config.ts",
    "build:server": "tsc -p tsconfig.server.json && npm run bundle:server",
    "bundle:server": "esbuild sites/index.ts --bundle --platform=browser --format=esm --target=es2022 --outfile=dist/server/index.js --sourcemap --external:node:fs/promises --external:node:path",
    "build:sites": "vinext build && tsx scripts/sanitize-sites-output.ts",
    "clean": "node --run clean:dist",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1",
    "start:local": "node dist/server/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.sites.json --noEmit",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:bundle",
    "verify:bundle": "tsx scripts/verify-client-bundle.ts",
    "probe:examiner": "tsx scripts/probe-examiner.ts",
    "evidence:phase03": "tsx scripts/export-phase-03-evidence.ts",
    "evidence:phase05": "tsx scripts/export-phase-05-evidence.ts",
    "verify:phase05:real": "tsx scripts/verify-phase-05-integration.ts",
    "evidence:phase06": "tsx scripts/export-phase-06-evidence.ts",
    "verify:phase06:real": "tsx scripts/verify-phase-06-integration.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "express": "5.2.1",
    "openai": "7.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "three": "0.186.0",
    "vinext": "1.0.0-beta.9",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@playwright/test": "1.63.0",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "esbuild": "^0.28.2",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
